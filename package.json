{
  "name": "stickbot",
  "version": "1.2.0",
  "description": "A bot that works as an alternative to built-in stickers, turning media into stickers",
  "keywords": [
    "bot",
    "discord",
    "stickers",
    "sticker",
    "node",
    "typescript",
    "lightweight",
    "self-hosted"
  ],
  "author": "Lucas Silva",
  "homepage": "https://github.com/lucassilvas1/stickbot/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucassilvas1/stickbot.git"
  },
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:dev": "cross-env NODE_ENV=development node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "deploy:dev": "npm run build && cross-env NODE_ENV=development node dist/deploy-commands.js",
    "deploy:prod": "npm run build && cross-env NODE_ENV=production node dist/deploy-commands.js",
    "test": "vitest -c src/vitest.config.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@vitest/coverage-v8": "^4.0.14",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "discord-button-width": "^1.1.1",
    "discord.js": "^14.24.2",
    "express": "^5.1.0",
    "kysely": "^0.28.8",
    "pino": "^10.1.0",
    "sharp": "^0.34.5",
    "undici": "^7.16.0",
    "zod": "^4.1.12"
  }
}
