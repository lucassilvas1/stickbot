# Discord
BOT_TOKEN=
APPLICATION_ID=
GUILD_ID=

# Cloudflare Tunnel — token from Zero Trust dashboard (Networks > Overview > Manage Tunnels > your tunnel > Configure)
TUNNEL_TOKEN=

# Assets server — public URL served by the Cloudflare tunnel
ASSETS_SERVER_HOSTNAME=https://your-subdomain.example.com/
ASSETS_SERVER_PORT=4675

# Optional
AUTOCOMPLETE_ORDER_BY=usage.count
LOG_LEVEL=info
LOG_TO_CONSOLE=false
MAX_LOG_AGE_DAYS=7
MAX_LOG_SIZE_MB=10
MAX_LOG_ROTATIONS=4
DOTENV_CONFIG_QUIET=true
